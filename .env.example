# Copy these into your shell, IDE run configuration, or a local .env file.
# Spring Boot does not load .env automatically; export the variables before starting.
#
# JWT_SECRET must be a Base64-encoded 32-byte (256-bit) key.
# PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
# OpenSSL:    openssl rand -base64 32

DB_URL=jdbc:postgresql://localhost:5432/finance_manager
DB_USERNAME=postgres
DB_PASSWORD=
JWT_SECRET=
